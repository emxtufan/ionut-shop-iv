# ==============================================================================
# IV Concept VOD - Configurare
# Copiază în .env și completează. Variabilele sunt citite DOAR de src/server/config.ts
# (și de Prisma pentru DATABASE_URL). Serverul nu pornește dacă lipsește una obligatorie.
# Variabilele setate direct pe server (panoul hostingului) au prioritate față de .env.
# ==============================================================================

# --- Server -------------------------------------------------------------------
# "production" = servește frontend-ul compilat din dist/ (rulează întâi `npm run build`).
# Local lasă linia comentată: se folosește serverul de dezvoltare Vite.
NODE_ENV=production
PORT=3000
# Adresa publică a site-ului, fără "/" la final. Stripe te trimite înapoi aici după plată
# și apare în linkurile din email-uri. Local: http://localhost:3000
APP_URL=https://www.domeniul-tau.ro
# Câte proxy-uri sunt în fața aplicației (nginx = 1, Cloudflare + nginx = 2, niciunul = 0).
# Necesar ca să vezi IP-ul real al clienților.
TRUST_PROXY_HOPS=1

# --- Baza de date PostgreSQL [obligatoriu] ------------------------------------
DATABASE_URL="postgresql://USER:PAROLA@HOST:5432/cinevault?schema=public"

# --- Primul cont de administrator ---------------------------------------------
# La pornire, dacă în baza de date nu există niciun admin, se creează un SUPER_ADMIN cu aceste date.
# După prima pornire șterge ADMIN_PASSWORD din .env.
ADMIN_EMAIL=admin@domeniul-tau.ro
ADMIN_PASSWORD=o-parola-lunga-de-minim-12-caractere

# --- Bunny Stream: filmele + protecția DRM MediaCage [obligatoriu] -----------
# Panoul Bunny -> Stream -> biblioteca ta:
#   API -> "Video Library ID" și "API Key"
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
#   Security -> activează "Embed view token authentication" și copiază "Token authentication key"
#   Security -> activează "MediaCage DRM"
#   Security -> "Allowed domains": pune doar domeniul tău (ex: www.domeniul-tau.ro)
BUNNY_STREAM_TOKEN_KEY=

# --- Stocare copertă (imagini) ------------------------------------------------
# Copertele se salvează în UPLOAD_DIR/thumbnails. Include folderul în backup.
UPLOAD_DIR=./storage
MAX_CONCURRENT_STREAMS=1

# --- Stripe [obligatoriu] -----------------------------------------------------
# Dashboard -> Developers -> API keys. sk_test_... pentru teste, sk_live_... pentru bani reali.
STRIPE_SECRET_KEY=
# Dashboard -> Developers -> Webhooks -> endpoint https://www.domeniul-tau.ro/api/payments/webhook
# Evenimente: checkout.session.completed, invoice.paid, charge.refunded, charge.dispute.created
# Local: `stripe listen --forward-to localhost:3000/api/payments/webhook` îți afișează un whsec_...
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=RON

# --- Datele firmei: facturi + pagini legale [nume, CIF, adresă obligatorii] ---
COMPANY_NAME="Firma Ta S.R.L."
COMPANY_CIF=RO00000000
COMPANY_ADDRESS="Strada, Nr, Oraș, Județ, România"
# Opțional. Emailul de contact afișat pe paginile Termeni / Confidențialitate / Cookies.
# Dacă îl lași gol, se folosește automat adresa din SMTP_FROM (ex: noreply@domeniul-tau.ro).
COMPANY_EMAIL=
# TVA inclus în preț (0.21 = 21%). Pune 0 dacă firma nu e plătitoare de TVA.
VAT_RATE=0.21
INVOICE_SERIES=CNV

# --- Email SMTP [obligatoriu] -------------------------------------------------
# Gmail: smtp.gmail.com, port 587, SMTP_PASS = "App Password" (nu parola contului)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="IV Concept <noreply@domeniul-tau.ro>"
